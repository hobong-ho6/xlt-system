            'current_version': current_version,
            'has_local_changes': has_changes,
            'repo_url': updater.repo_url,
            'last_check': datetime.now().isoformat()
        })

    except Exception as e:
        return jsonify({
            'status': 'error',
            'error': f'업데이트 상태 조회 중 오류가 발생했습니다: {str(e)}'
        }), 500

@app.route('/api/status')
def api_status():
    """기본 시스템 상태 (기존 호환성 유지)"""
    try:
        # 피그마 연결 상태 확인
        figma_status = False
        figma_error = ""
        try:
            from xlt.input.figma import FigmaProcessor
            figma_processor = FigmaProcessor(pipeline.config)
            figma_status = bool(figma_processor.figma_token and figma_processor.test_figma_connection())
        except Exception as e:
            figma_error = str(e)

        return jsonify({
            'status': 'running' if pipeline else 'error',
            'version': '2.0.0-stable',
            'pipeline_ready': pipeline is not None,
            'figma_ready': figma_status,
            'figma_error': figma_error if not figma_status else None,
            'temp_sessions': len(temp_ocr_results)
        })
    except Exception as e:
        return jsonify({
            'status': 'error',
            'error': str(e)
        }), 500

# XLT v3.0: 로그 API 제거
# @app.route('/api/logs/<session_id>') - 로그 기능 제거됨

@app.route('/api/translation-progress/<session_id>')
def get_translation_progress(session_id):
    """번역 진행 상황 조회"""
    try:
        status_data = session_status.get(session_id, {})
        translation_progress = status_data.get('translation_progress', {})

        return jsonify({
            'status': 'success',
            'progress': translation_progress,
            'timestamp': datetime.now().isoformat()
        })
    except Exception as e:
        return jsonify({
            'status': 'error',
            'error': str(e)
        }), 500

def load_translation_guide_api():
    """API용 guide.md 번역 가이드라인 로드 (전체 내용 반환)"""
    try:
        guide_path = os.path.join(os.path.dirname(__file__), 'guide.md')

        if not os.path.exists(guide_path):
            return {
                'status': 'error',
                'error': 'guide.md 파일을 찾을 수 없습니다.',
                'path': guide_path
            }

        with open(guide_path, 'r', encoding='utf-8') as f:
            content = f.read()

        return {
            'status': 'success',
            'content': content,
            'file': 'guide.md',
            'size': len(content),
            'last_modified': datetime.fromtimestamp(os.path.getmtime(guide_path)).isoformat()
        }
    except Exception as e:
        return {
            'status': 'error',
            'error': f'guide.md 로드 중 오류: {str(e)}'
        }

@app.route('/api/translation-guide')
def api_translation_guide():
    """번역 가이드라인 제공 (guide.md)"""
    try:
        result = load_translation_guide_api()

        if result['status'] == 'error':
            return jsonify(result), 404

        return jsonify(result)
    except Exception as e:
        return jsonify({
            'status': 'error',
            'error': str(e)
        }), 500

# XLT v3.0: 테스트 기능들 제거
# @app.route('/test-ocr') - OCR 테스트 페이지 제거됨
# @app.route('/test-selection') - 선택 테스트 페이지 제거됨

@app.route('/api/figma-preview', methods=['POST'])
def figma_preview():
    """피그마 URL의 이미지 미리보기 제공"""
    try:
        data = request.get_json()
        if not data or 'figma_url' not in data:
            return jsonify({
                'status': 'error',
                'error': 'Figma URL이 필요합니다.'
            }), 400

        figma_url = data['figma_url'].strip()
        if not figma_url:
            return jsonify({
                'status': 'error',
                'error': 'Figma URL을 입력해주세요.'
            }), 400

        # 피그마 URL 형식 기본 검증
        if 'figma.com' not in figma_url:
            return jsonify({
                'status': 'error',
                'error': '올바른 Figma URL을 입력해주세요.'
            }), 400

        print(f"📱 피그마 미리보기 요청: {figma_url}")

        # 피그마 프로세서 초기화
        from xlt.input.figma import FigmaProcessor
        from PIL import Image
        figma_processor = FigmaProcessor(pipeline.config)

        # 피그마 토큰 확인
        if not figma_processor.figma_token:
            return jsonify({
                'status': 'error',
                'error': '피그마 토큰이 설정되지 않았습니다. figma_config.json을 확인해주세요.'
            }), 400

        # 피그마 이미지 다운로드
        try:
            image, description = figma_processor.process(figma_url)

            if not image:
                return jsonify({
                    'status': 'error',
                    'error': '이미지를 로드할 수 없습니다. URL을 확인해주세요.'
                }), 400

            # 이미지를 Base64로 인코딩하여 브라우저에서 표시 가능하게 만들기
            import base64
            from io import BytesIO

            # 이미지 크기 조정 (미리보기용으로 최대 400px)
            max_width = 400
            if image.width > max_width:
                ratio = max_width / image.width
                new_height = int(image.height * ratio)
                image = image.resize((max_width, new_height), Image.LANCZOS)

            # Base64 인코딩
            buffer = BytesIO()
            image.save(buffer, format='PNG')
            img_data = base64.b64encode(buffer.getvalue()).decode()

            # URL에서 메타데이터 추출
            try:
                # URL에서 node-id와 file-id 추출
                import re
                file_match = re.search(r'/design/([^/?]+)', figma_url)
                node_match = re.search(r'node-id=([^&]+)', figma_url)

                file_id = file_match.group(1) if file_match else 'Unknown'
                node_id = node_match.group(1) if node_match else 'Unknown'
            except:
                file_id = 'Unknown'
                node_id = 'Unknown'

            # 메타데이터 정리
            clean_metadata = {
                'width': image.width,
                'height': image.height,
                'format': 'PNG',
                'source': 'Figma',
                'node_id': node_id,
                'file_id': file_id,
                'description': description
            }

            return jsonify({
                'status': 'success',
                'image_data': f'data:image/png;base64,{img_data}',
                'metadata': clean_metadata,
                'message': '피그마 이미지 미리보기 로드 성공'
            })

        except Exception as figma_error:
            error_msg = str(figma_error)
            print(f"❌ 피그마 처리 오류: {error_msg}")

            # 구체적인 오류 메시지 제공
            if 'Invalid node' in error_msg or 'node not found' in error_msg:
                user_error = '지정된 노드를 찾을 수 없습니다. URL의 node-id를 확인해주세요.'
            elif 'Invalid file' in error_msg or 'file not found' in error_msg:
                user_error = '피그마 파일을 찾을 수 없습니다. URL을 확인해주세요.'
            elif 'Permission' in error_msg or 'access' in error_msg.lower():
                user_error = '피그마 파일에 접근할 권한이 없습니다. 파일이 공개되어 있는지 확인해주세요.'
            elif 'token' in error_msg.lower():
                user_error = '피그마 토큰이 유효하지 않습니다. figma_config.json의 토큰을 확인해주세요.'
            else:
                user_error = f'피그마 이미지 로드 실패: {error_msg}'

            return jsonify({
                'status': 'error',
                'error': user_error
            }), 400

    except Exception as e:
        error_trace = traceback.format_exc()
        print(f"❌ 피그마 미리보기 API 오류: {e}")
        print(f"   상세 오류: {error_trace}")

        return jsonify({
            'status': 'error',
            'error': f'서버 오류가 발생했습니다: {str(e)}'
        }), 500


# ===================================
# Slack 모니터링 API 엔드포인트
# ===================================

# Slack 관련 전역 변수
slack_monitor = None
notification_manager = None

def initialize_slack_system():
    """Slack 시스템 초기화"""
    global slack_monitor, notification_manager

    try:
        from xlt.core.config import XLTConfig
        from xlt.integrations import create_slack_system, SLACK_AVAILABLE

        if not SLACK_AVAILABLE:
            logger.warning("Slack 통합 모듈을 사용할 수 없습니다")
            return False

        # 설정 로드
        config = XLTConfig.from_file('user_config.json')

        if not config.is_slack_enabled():
            logger.info("Slack 모니터링이 비활성화되어 있습니다")
            return False

        # 시스템 초기화
        slack_monitor, notification_manager = create_slack_system(config, logger)

        # 모니터링 시작
        slack_monitor.start_monitoring()

        logger.info("✅ Slack 모니터링 시스템 초기화 완료")

        # 초기 통계 로깅
        stats = slack_monitor.get_stats()
        logger.info(f"📊 모니터링 상태: 사용자 {stats.get('user_name', 'Unknown')}")

        return True

    except ValueError as e:
        logger.warning(f"⚠️ Slack 설정 문제: {e}")
        return False
    except Exception as e:
        logger.error(f"❌ Slack 시스템 초기화 실패: {e}")
        return False

@app.route('/slack-dashboard')
def slack_dashboard():
    """Slack 모니터링 대시보드 메인 페이지"""
    try:
        return render_template('slack_dashboard.html')
    except Exception as e:
        logger.error(f"Slack 대시보드 렌더링 실패: {e}")
        return jsonify({
            'status': 'error',
            'error': f'대시보드를 로드할 수 없습니다: {str(e)}'
        }), 500

@app.route('/api/slack/status', methods=['GET', 'OPTIONS'])
def api_slack_status():
    """Slack 모니터링 상태 조회"""
    if request.method == 'OPTIONS':
        return '', 200

    try:
        global slack_monitor

        if not slack_monitor:
            return jsonify({
                'status': 'error',
                'error': 'Slack 모니터링이 초기화되지 않았습니다',
                'enabled': False
            }), 503

        stats = slack_monitor.get_stats()

        return jsonify({
            'status': 'success',
            'monitoring': {
                'enabled': True,
                'running': slack_monitor.is_running(),
                'stats': stats
            },
            'timestamp': datetime.now().isoformat()
        })

    except Exception as e:
        logger.error(f"Slack 상태 조회 실패: {e}")
        return jsonify({
            'status': 'error',
            'error': f'상태 조회 중 오류가 발생했습니다: {str(e)}'
        }), 500

@app.route('/api/slack/messages', methods=['GET', 'OPTIONS'])
def api_slack_messages():
    """최근 Slack 메시지 및 알림 조회"""
    if request.method == 'OPTIONS':
        return '', 200

    try:
        global notification_manager

        if not notification_manager:
            return jsonify({
                'status': 'error',
                'error': 'Slack 시스템이 초기화되지 않았습니다'
            }), 503

        # 쿼리 파라미터
        limit = request.args.get('limit', 50, type=int)
        unread_only = request.args.get('unread_only', 'false').lower() == 'true'

        # 웹 알림 목록 가져오기
        notifications = notification_manager.get_web_notifications(
            limit=limit,
            unread_only=unread_only
        )

        return jsonify({
            'status': 'success',
            'notifications': notifications,
            'count': len(notifications),
            'timestamp': datetime.now().isoformat()
        })

    except Exception as e:
        logger.error(f"Slack 메시지 조회 실패: {e}")
        return jsonify({
            'status': 'error',
            'error': f'메시지 조회 중 오류가 발생했습니다: {str(e)}'
        }), 500

@app.route('/api/slack/reply', methods=['POST', 'OPTIONS'])
def api_slack_reply():
    """Slack 스레드에 답변 전송"""
    if request.method == 'OPTIONS':
        return '', 200

    try:
        global slack_monitor

        if not slack_monitor:
            return jsonify({
                'status': 'error',
                'error': 'Slack 모니터링이 초기화되지 않았습니다'
            }), 503

        data = request.get_json()
        if not data:
            return jsonify({
                'status': 'error',
                'error': '요청 데이터가 비어있습니다'
            }), 400

        channel_id = data.get('channel_id')
        message = data.get('message')
        thread_ts = data.get('thread_ts')  # 선택적

        if not channel_id or not message:
            return jsonify({
                'status': 'error',
                'error': 'channel_id와 message는 필수입니다'
            }), 400

        # Slack API를 통해 메시지 전송
        slack_client = slack_monitor.slack_client

        if thread_ts:
            result = slack_client.reply_to_thread(channel_id, thread_ts, message)
        else:
            result = slack_client.post_message(channel_id, message)

        return jsonify({
            'status': 'success',
            'message': '메시지가 성공적으로 전송되었습니다',
            'result': result,
            'timestamp': datetime.now().isoformat()
        })

    except Exception as e:
        logger.error(f"Slack 메시지 전송 실패: {e}")
        return jsonify({
            'status': 'error',
            'error': f'메시지 전송 중 오류가 발생했습니다: {str(e)}'
        }), 500

@app.route('/api/slack/config', methods=['GET', 'OPTIONS'])
def api_slack_config_get():
    """Slack 설정 조회"""
    if request.method == 'OPTIONS':
        return '', 200

    try:
        from xlt.core.config import XLTConfig

        config = XLTConfig.from_file('user_config.json')
        slack_config = config.slack_config

        # 민감한 정보는 제외하고 반환
        safe_config = {
            'enabled': slack_config.get('enabled', False),
            'monitoring_interval': slack_config.get('monitoring_interval', 30),
            'monitored_channels': slack_config.get('monitored_channels', []),
            'keywords': slack_config.get('keywords', []),
            'notification_methods': slack_config.get('notification_methods', []),
            'mention_monitoring': slack_config.get('mention_monitoring', True),
            'thread_monitoring': slack_config.get('thread_monitoring', True),
            'keyword_monitoring': slack_config.get('keyword_monitoring', True),
            'web_dashboard_enabled': slack_config.get('web_dashboard_enabled', True),
            'alert_sound_enabled': slack_config.get('alert_sound_enabled', True),
            'quiet_hours': slack_config.get('quiet_hours', {})
        }

        return jsonify({
            'status': 'success',
            'config': safe_config,
            'has_token': bool(config.get_slack_token())
        })

    except Exception as e:
        logger.error(f"Slack 설정 조회 실패: {e}")
        return jsonify({
            'status': 'error',
            'error': f'설정 조회 중 오류가 발생했습니다: {str(e)}'
        }), 500

@app.route('/api/slack/config', methods=['POST', 'OPTIONS'])
def api_slack_config_post():
    """Slack 설정 업데이트"""
    if request.method == 'OPTIONS':
        return '', 200

    try:
        from xlt.core.config import XLTConfig

        data = request.get_json()
        if not data:
            return jsonify({
                'status': 'error',
                'error': '요청 데이터가 비어있습니다'
            }), 400

        config = XLTConfig.from_file('user_config.json')

        # 설정 업데이트
        for key, value in data.items():
            if key in config.slack_config:
                config.slack_config[key] = value

        # 설정 저장
        config.to_file('user_config.json')

        # Slack 시스템 재시작 (설정이 변경된 경우)
        if data.get('enabled') and not (slack_monitor and slack_monitor.is_running()):
            initialize_slack_system()
        elif not data.get('enabled') and slack_monitor and slack_monitor.is_running():
            slack_monitor.stop_monitoring()

        return jsonify({
            'status': 'success',
            'message': '설정이 성공적으로 업데이트되었습니다',
            'timestamp': datetime.now().isoformat()
        })

    except Exception as e:
        logger.error(f"Slack 설정 업데이트 실패: {e}")
        return jsonify({
            'status': 'error',
            'error': f'설정 업데이트 중 오류가 발생했습니다: {str(e)}'
        }), 500

@app.route('/api/slack/notifications/<notification_id>/read', methods=['POST', 'OPTIONS'])
def api_slack_mark_read(notification_id):
    """알림을 읽음으로 표시"""
    if request.method == 'OPTIONS':
        return '', 200

    try:
        global notification_manager

        if not notification_manager:
            return jsonify({
                'status': 'error',
                'error': 'Slack 시스템이 초기화되지 않았습니다'
            }), 503

        success = notification_manager.mark_notification_read(notification_id)

        if success:
            return jsonify({
                'status': 'success',
                'message': '알림이 읽음으로 표시되었습니다'
            })
        else:
            return jsonify({
                'status': 'error',
                'error': '해당 알림을 찾을 수 없습니다'
            }), 404

    except Exception as e:
        logger.error(f"알림 읽음 표시 실패: {e}")
        return jsonify({
            'status': 'error',
            'error': f'알림 처리 중 오류가 발생했습니다: {str(e)}'
        }), 500

@app.route('/api/slack/test', methods=['POST', 'OPTIONS'])
def api_slack_test():
    """Slack 알림 시스템 테스트"""
    if request.method == 'OPTIONS':
        return '', 200

    try:
        global notification_manager

        if not notification_manager:
            return jsonify({
