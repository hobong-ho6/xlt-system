        return jsonify({
            'status': 'error',
            'error': f'테스트 중 오류가 발생했습니다: {str(e)}'
        }), 500

@app.route('/api/slack/stream', methods=['GET', 'OPTIONS'])
def api_slack_stream():
    """Server-Sent Events를 통한 실시간 알림 스트림"""
    if request.method == 'OPTIONS':
        return '', 200
    def generate():
        """실시간 알림 스트림 생성"""
        # SSE 헤더
        yield "data: {\"type\": \"connected\", \"message\": \"Slack 실시간 스트림 연결됨\"}\n\n"

        # 실제 구현에서는 알림 큐를 실시간 모니터링
        import time
        while True:
            try:
                if notification_manager:
                    # 최근 알림 확인 (간단한 구현)
                    notifications = notification_manager.get_web_notifications(
                        limit=1, unread_only=True
                    )

                    for notif in notifications:
                        yield f"data: {json.dumps({'type': 'notification', 'data': notif})}\n\n"

                time.sleep(5)  # 5초마다 확인

            except Exception as e:
                yield f"data: {json.dumps({'type': 'error', 'message': str(e)})}\n\n"
                break

    from flask import Response
    return Response(generate(), mimetype='text/event-stream')

@app.route('/api/slack/channels', methods=['GET', 'OPTIONS'])
def api_slack_channels():
    """사용자가 참여한 Slack 채널 목록"""
    if request.method == 'OPTIONS':
        return '', 200

    try:
        global slack_monitor

        if not slack_monitor:
            return jsonify({
                'status': 'error',
                'error': 'Slack 모니터링이 초기화되지 않았습니다'
            }), 503

        channels = slack_monitor.slack_client.get_channels()

        return jsonify({
            'status': 'success',
            'channels': channels,
            'count': len(channels),
            'timestamp': datetime.now().isoformat()
        })

    except Exception as e:
        logger.error(f"Slack 채널 목록 조회 실패: {e}")
        return jsonify({
            'status': 'error',
            'error': f'채널 목록 조회 중 오류가 발생했습니다: {str(e)}'
        }), 500


